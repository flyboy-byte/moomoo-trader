MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
TRD_ENV=SIMULATE

LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION=false

SYMBOL=US.SPY
# Multi-symbol paper runner. Comma-separated. Overrides SYMBOL when set.
# SYMBOLS=US.SPY,US.QQQ,US.IWM
CANDLE_KTYPE=K_5M

MAX_TRADES_PER_DAY=3
MAX_TRADES_PER_STRATEGY=0           # per-strategy cap (0 = disabled, global limit only)
MAX_DAILY_LOSS=20
MAX_POSITION_DOLLARS=50
# Per-symbol overrides. Falls back to MAX_POSITION_DOLLARS for symbols not listed.
# Example: give IWM more dollars than SPY.
# SYMBOL_SIZE_OVERRIDES=US.IWM:300,US.SPY:600,US.QQQ=500

# MD5 hash of your Moomoo trade password (required to unlock the SIMULATE trade account).
# Generate with: python -c "import hashlib; print(hashlib.md5('yourpassword'.encode()).hexdigest())"
TRADE_PASSWORD_MD5=

# Multi-strategy: run multiple strategies simultaneously on the same symbols.
# Each (symbol, strategy) pair has independent position state and P&L tracking.
# Candles are fetched once per symbol and shared across all active strategies.
# Available: bb_kdj, orb, vwap_pb (VWAP flush-and-reclaim), vwap (deprecated crossover)
STRATEGIES=bb_kdj,orb,vwap_pb

# VWAP Pullback strategy (flush-and-reclaim — sweep on SPY+QQQ 2022-2025)
# IWM excluded (fails OOS). Restrict via VWAP_PB_SYMBOLS.
# VWAP_PB_SYMBOLS=US.SPY,US.QQQ   # empty = all active symbols
VWAP_PB_STOP_MULT=1.0             # ATR stop below entry (1.0 optimal)
VWAP_PB_MAX_CROSSES=1             # max VWAP crosses in session before signal is void
VWAP_PB_MIN_ENTRY_TIME=10:00      # no entries before this ET time (sweep: 10:00 >> 9:45)

# VWAP crossover strategy (deprecated — PF~1.0, avg hold 1 bar on 5-min)
VWAP_BAND_MULT=0.5
VWAP_STOP_MULT=0.75

# ORB strategy parameters (only used when STRATEGIES includes orb)
# Sweep on SPY+QQQ+IWM 2022-2025: 15-min OR + 1.5× target is optimal (PF=1.215, 54.5% win).
ORB_MINUTES=15                             # opening range window: 15 or 30 min (default)
# ORB_MINUTES_OVERRIDES=US.IWM:30,US.QQQ:15  # per-symbol: IWM needs 30-min (PF 1.02→1.22)
ORB_TARGET_MULT=1.5    # target = mult × OR range height
ORB_VOL_MULT=1.2       # volume confirmation: require > 1.2× 20-bar MA on breakout bar
ORB_MIN_RANGE_PCT=0.001  # skip if OR width < 0.1% of price (dead open)
ORB_MAX_RANGE_PCT=0.008  # skip if OR width > 0.8% of price (news spike)
ORB_SHORTS_ENABLED=true  # set to false or touch STOP_SHORTS.txt to disable short entries

# Strategy mode: "strict" = BB touch + KDJ cross + bonus>=MIN_SIGNAL_SCORE (default, production)
#                "permissive" = BB touch only + bonus>=1 (use to validate order execution flow)
STRATEGY_MODE=strict

# KDJ window: look back N bars for a KDJ golden cross when entering at BB lower.
# 0 = same-bar only (original). Sweep on IWM+QQQ 2022-2025: w=3 gives 10x more trades, PF>1.1,
# improves OOS. SPY breaks at any window>0 — override per symbol with KDJ_WINDOW_OVERRIDES.
KDJ_WINDOW_BARS=3
# KDJ_WINDOW_OVERRIDES=US.SPY:0   # keep SPY at same-bar; IWM/QQQ use KDJ_WINDOW_BARS

DISCORD_WEBHOOK_URL=
# DASHBOARD_PASSWORD=              # set to enable/require auth on the /config editor

# Research finding: KDJ death cross exit cuts winners early. Default false = target+stop only.
EXIT_ON_KDJ_DEATH=false

# ATR stop multiplier. Sweep on 2022-2025 SPY 5-min: 1.0 has best PnL + walk-forward consistency.
ATR_STOP_MULT=1.0

# Bonus confirmation threshold (0-3). Core BB+KDJ entry is always required.
# Bonus signals: rsi_oversold (<35), ranging (ADX<25), volume_spike (>1.5x avg).
# 0 = original BB+KDJ only.  2 = best results (51.7% win, PF=1.843, default).
MIN_SIGNAL_SCORE=2
