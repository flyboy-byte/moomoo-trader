# Frozen, symbol-agnostic strategy parameters for the wide scan (PLAN.md Step 6a).
# Frozen 2026-09-17, before any wide-scan symbol history was fetched.
#
# Derived from docs/frozen_config_2026-09-17.env (the live VPS settings) by keeping
# every BASE value and dropping every per-symbol override and allowlist: those were
# tuned on SPY/QQQ/IWM, and applying them to three symbols out of 85 would compare
# tuning, not symbols. The live runner is NOT changed by this file.
#
# Two deliberate choices beyond "drop the overrides":
#   KDJ_WINDOW_BARS=0  — the live base is 3 but only QQQ runs it; SPY/IWM run 0, and
#                        evaluation_criteria.md calls w=0 "the best-validated finding
#                        in the project". One value has to be picked; this is it.
#   ORB shorts on for every symbol — the live SPY-only allowlist came from 36 live
#                        QQQ/IWM trades. Long and short results are reported separately.
#
# Context gates are OFF because no history exists for them before mid-2026 (VIX log,
# regime classifier) and a paid LLM call per bar is out of scope:
#   REGIME_GATE_ENABLED=false, ORB_SETUP_SCORER_ENABLED=false, no VIX caps.
#
# Changing any line after the scan starts requires a new dated preregistration, and
# the 2019-2021 holdout is then considered spent.

CANDLE_KTYPE=K_5M
STRATEGY_MODE=strict
STRATEGIES=bb_kdj,orb,vwap_pb,gap_fade

# bb_kdj
KDJ_WINDOW_BARS=0
KDJ_WINDOW_OVERRIDES=
MIN_SIGNAL_SCORE=2
ATR_STOP_MULT=1.0
EXIT_ON_KDJ_DEATH=false

# orb
ORB_MINUTES=15
ORB_MINUTES_OVERRIDES=
ORB_VOL_MULT=1.5
ORB_VOL_MULT_OVERRIDES=
ORB_TARGET_MULT=1.5
ORB_TARGET_MULT_OVERRIDES=
ORB_MIN_RANGE_PCT=0.001
ORB_MAX_RANGE_PCT=0.008
ORB_LATEST_ENTRY=12:30
ORB_SHORTS_ENABLED=true
ORB_SHORT_SYMBOLS=
ORB_VIX_MAX=
ORB_VIX_MAX_OVERRIDES=
ORB_SETUP_SCORER_ENABLED=false
ORB_ENTRY_MIN_CONFIDENCE=0.0

# vwap_pb
VWAP_PB_SYMBOLS=
VWAP_PB_STOP_MULT=1.0
VWAP_PB_MAX_CROSSES=1
VWAP_PB_MIN_ENTRY_TIME=10:00

# gap_fade
GAP_MIN_PCT=0.003
GAP_MAX_PCT=0.02
GAP_TARGET_FILL_PCT=0.5
GAP_STOP_BUFFER=0.001
GAP_SHORTS_ENABLED=true
GAP_MAX_SHORT_PCT=0.01
GAP_LARGE_SHORT_FILTER_ENABLED=true
GAP_PREMARKET_FILTER_ENABLED=false
GAP_VIX_MAX=
GAP_VIX_MAX_OVERRIDES=

# context
REGIME_GATE_ENABLED=false
