# Frozen VPS strategy configuration for the 2026-09-17 forward cohort and the
# PLAN.md Step 5 engine cross-validation. Copied from the VPS .env on 2026-09-17
# (runtime code f1ed556). Secrets, hosts, and model names are deliberately
# omitted. scripts/cross_validate_engines.py loads ONLY this file, never the
# local .env. A change here is a cohort change: see evaluation_criteria.md.
CANDLE_KTYPE=K_5M
STRATEGY_MODE=strict
ATR_STOP_MULT=1.0
EXIT_ON_KDJ_DEATH=false
FRACTIONAL_SHARES=false
GAP_LARGE_SHORT_FILTER_ENABLED=true
GAP_VIX_MAX=
GAP_VIX_MAX_OVERRIDES=US.SPY:20,US.QQQ:20
KDJ_WINDOW_BARS=3
KDJ_WINDOW_OVERRIDES=US.SPY:0,US.IWM:0
LIVE_CONFIRMATION=false
LIVE_TRADING_ENABLED=false
MAX_DAILY_LOSS=20
MAX_POSITION_DOLLARS=900
MAX_TRADES_PER_DAY=0
MAX_TRADES_PER_STRATEGY=0
MIN_SIGNAL_SCORE=2
ORB_ENTRY_MIN_CONFIDENCE=0.0
ORB_LATEST_ENTRY=12:30
ORB_MINUTES=15
ORB_MINUTES_OVERRIDES=US.IWM:30
ORB_SETUP_SCORER_ENABLED=true
ORB_SHORTS_ENABLED=true
ORB_SHORT_SYMBOLS=US.SPY
ORB_TARGET_MULT=1.5
ORB_TARGET_MULT_OVERRIDES=US.QQQ:2.0,US.IWM:1.0
ORB_VIX_MAX=
ORB_VIX_MAX_OVERRIDES=US.IWM:18
ORB_VOL_MULT=1.5
ORB_VOL_MULT_OVERRIDES=US.SPY:2.0
REGIME_GATE_ENABLED=true
REGIME_GATE_STRATEGIES=bb_kdj,bb_kdj_loose
REGIME_SKIP_LABELS=trending_up,trending_down
STRATEGIES=bb_kdj,orb,vwap_pb,bb_kdj_loose,gap_fade
SYMBOLS=US.IWM,US.SPY,US.QQQ
TOTAL_CAPITAL=0
TRD_ENV=SIMULATE
VWAP_PB_MAX_CROSSES=1
VWAP_PB_STOP_MULT=1.0
VWAP_PB_SYMBOLS=US.SPY,US.QQQ,US.IWM
